# =============================================================================
# FootballFixtures — root env example
# Copy to .env and fill in values. NEVER commit .env to the repo.
# =============================================================================

# --- Server (packages/server) ------------------------------------------------

# API-Football (api-sports.io) key — server-side only, never expose to client.
# Sign up at https://dashboard.api-football.com/, copy the key from the dashboard.
# OPTIONAL for local dev: leave blank to serve the pinned seed snapshot only
# (schedule/standings/live/game all work; POST /poll becomes a no-op).
API_FOOTBALL_KEY=

# Cap on API-Football calls per day (free tier ~100/day). Defaults to 90.
API_FOOTBALL_DAILY_LIMIT=90

# Shared secret for POST /poll. Must match POLL_SECRET in tools/poller/.env.
# Required only if you run the live poller. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POLL_SECRET=

# Port the Hono server listens on (Render sets PORT automatically).
PORT=3000

# --- App (packages/app) — Expo / EAS -----------------------------------------

# Your Expo project ID (from expo.dev after running `eas init`).
EXPO_PROJECT_ID=

# Base URL of the server, exposed to the Expo bundle (EXPO_PUBLIC_ prefix required).
# Leave empty for local dev on a simulator/web (defaults to http://localhost:3000).
# On a PHYSICAL device, localhost points at the phone — set this to your computer's
# LAN IP instead, e.g. http://192.168.1.50:3000. Expo reads .env from packages/app/,
# so for the app set this in packages/app/.env or inline it when starting Expo:
#   EXPO_PUBLIC_SERVER_URL=http://192.168.1.50:3000 npm run dev:app
EXPO_PUBLIC_SERVER_URL=

# --- Poller (tools/poller) — see also tools/poller/.env.example ---------------
# These live in tools/poller/.env, not here. See that file for details.
