# =============================================================================
# FootballFixtures — root env example
# Copy to .env and fill in values. NEVER commit .env to the repo.
# =============================================================================

# --- Server (packages/server) ------------------------------------------------

# API-Football (api-sports.io) key — server-side only, never expose to client.
# Sign up at https://dashboard.api-football.com/, copy the key from the dashboard.
API_FOOTBALL_KEY=

# Shared secret for POST /poll. Must match POLL_SECRET in tools/poller/.env.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POLL_SECRET=

# Port the Hono server listens on (Render sets PORT automatically).
PORT=3000

# --- App (packages/app) — Expo / EAS -----------------------------------------

# Your Expo project ID (from expo.dev after running `eas init`).
EXPO_PROJECT_ID=

# Base URL of the deployed server, exposed to the Expo bundle (EXPO_PUBLIC_ prefix required).
# Leave empty for local dev (defaults to http://localhost:3000).
EXPO_PUBLIC_SERVER_URL=

# --- Poller (tools/poller) — see also tools/poller/.env.example ---------------
# These live in tools/poller/.env, not here. See that file for details.
