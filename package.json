{
  "name": "footballfixtures",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace @footballfixtures/shared",
    "build": "tsc --build packages/shared packages/server",
    "build:shared": "npm run build --workspace @footballfixtures/shared",
    "dev:server": "npm run dev --workspace @footballfixtures/server",
    "dev:app": "npm run start --workspace @footballfixtures/app",
    "typecheck": "tsc --build packages/shared packages/server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
