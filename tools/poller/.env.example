# Required ----------------------------------------------------------------

# Deployed server base URL, no trailing slash.
# e.g. https://footballfixtures.onrender.com
SERVER_URL=

# Shared secret used to authenticate POST /poll.
# MUST match the secret the server checks (Authorization: Bearer <POLL_SECRET>).
POLL_SECRET=

# Optional tunables (defaults shown) ---------------------------------------

# How often to hit /poll while a game is in its window (seconds).
LIVE_CADENCE_SEC=60

# Start a window this many minutes before kickoff.
LEAD_MIN=5

# Keep the window open this many minutes after kickoff
# (90' + half-time + stoppage + buffer).
MATCH_WINDOW_MIN=130

# Re-fetch the schedule at least this often (minutes).
SCHEDULE_REFRESH_MIN=30

# Never sleep longer than this while idle (minutes).
IDLE_RECHECK_MAX_MIN=15

# Write-back (Milestone 3) ---------------------------------------------------
# Absolute path to data/competitions/world-cup-2026.json in your local checkout.
# When set, the poller commits final scores back to this file after each FT event.
# The machine must have git configured with push access to the repo.
# e.g. /home/user/FootballFixtures/data/competitions/world-cup-2026.json
REPO_DATA_PATH=
